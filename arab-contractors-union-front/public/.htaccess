# SPA (Vue) static host — أي مسار غير موجود يُخدَم عبر index.html ليتكفّل به vue-router
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    DirectoryIndex index.html

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # إزالة السلاش الأخير لغير المجلدات
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # SPA fallback: لو مش ملف ولا مجلد حقيقي → index.html
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.html [L]
</IfModule>

# لا تُخزّن index.html في الكاش حتى يظهر أي نشر جديد فوراً
<IfModule mod_headers.c>
    <FilesMatch "index\.html$">
        Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    </FilesMatch>
</IfModule>
