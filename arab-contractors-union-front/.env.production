# يُستخدم تلقائياً عند `npm run build` (وضع production).
# الـ base = أصل الدومين فقط (بدون /api/v1) — الكود يضيف /api/v1 بالمسارات.
VITE_API_BASE_URL=https://api.pcuorg.cloud

# إشعارات الأدمن الفورية (Reverb) — القيمة يجب أن تطابق REVERB_APP_KEY في .env على السيرفر
# (انظر ملاحظات النشر — Nginx يُمرِّر wss عبر نفس الدومين فلا حاجة لبورت منفصل)
VITE_REVERB_APP_KEY=__MUST_MATCH_SERVER_REVERB_APP_KEY__
VITE_REVERB_HOST=api.pcuorg.cloud
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https
